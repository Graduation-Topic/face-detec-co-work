SUPABASE_DIRECT_CONNECTION_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-xxx.pooler.supabase.com:6543/postgres
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key

# LINE Messaging API 全域預設 Token (選填，若個別使用者未填寫自訂 Token 則使用此預設值)
LINE_CHANNEL_ACCESS_TOKEN=

# Discord Webhook 全域通知網址 (選填，建立頻道 Webhook 後貼上即可，免公司帳號審核)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# Telegram Bot API 全域通知設定 (選填，向 @BotFather 申請 Bot Token，並填入 Chat ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
