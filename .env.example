# PostgreSQL Direct / Pooler 連線字串 (供 psycopg 原生 SQL 查詢使用)
SUPABASE_DIRECT_CONNECTION_URL=postgresql://postgres.xxx:[YOUR-PASSWORD]@aws-0-xxx.pooler.supabase.com:6543/postgres

# Supabase Project API (供 Supabase SDK / Storage 截圖 / Realtime 雲端服務使用)
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_or_publishable_key
